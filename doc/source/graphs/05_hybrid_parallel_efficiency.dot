   digraph HybridParallelEfficiency {
       rankdir=TB;

       graph [
           bgcolor="transparent",
           nodesep=0.45,
           ranksep=0.45
       ];

       node [
           shape=box,
           fontname="Helvetica",
           fontsize=10,
           style="filled",
           color="#6B7C8F",
           penwidth=1.0
       ];

       edge [
           color="#526477",
           penwidth=1.0,
           arrowsize=0.7
       ];

       hybrid_pe [
           label="Hybrid Parallel Efficiency",
           fillcolor="#C8E6C9"
       ];

       hybrid_lb [
           label="Hybrid Load Balance",
           fillcolor="#E8F5E9"
       ];

       hybrid_ce [
           label="Hybrid Communication Efficiency",
           fillcolor="#E8F5E9"
       ];

       hybrid_pe -> hybrid_lb;
       hybrid_pe -> hybrid_ce;
   }

   