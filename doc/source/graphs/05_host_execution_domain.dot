digraph HostExecutionDomain {
    rankdir=TB;

    graph [
        bgcolor="transparent",
        nodesep=0.45,
        ranksep=0.50
    ];

    node [
        shape=box,
        fontname="Helvetica",
        fontsize=10,
        style="filled",
        penwidth=1.0
    ];

    edge [
        color="#526477",
        penwidth=1.0,
        arrowsize=0.7
    ];

    /*
     * Host Global Efficiency
     */

    host_ge [
        label="Host Global\nEfficiency",
        fillcolor="#ECEFF1",
        color="#546E7A",
        penwidth=1.3
    ];

    /*
     * Host Parallel Efficiency branch
     */

    host_pe [
        label="Host Parallel\nEfficiency",
        fillcolor="#C8E6C9",
        color="#2E7D32"
    ];

    mpi_pe [
        label="MPI Parallel\nEfficiency",
        fillcolor="#E8F5E9",
        color="#2E7D32"
    ];

    offload [
        label="Device Offload\nEfficiency",
        fillcolor="#E8F5E9",
        color="#EF6C00"
    ];

    /*
     * Host Computation Scalability branch
     */

    host_cs [
        label="Host Computation\nScalability",
        fillcolor="#BBDEFB",
        color="#4A90C2"
    ];

    host_ipc [
        label="Host IPC\nScalability",
        fillcolor="#E3F2FD",
        color="#4A90C2"
    ];

    host_instruction [
        label="Host Instruction\nScalability",
        fillcolor="#E3F2FD",
        color="#4A90C2"
    ];

    host_frequency [
        label="Host Frequency\nScalability",
        fillcolor="#E3F2FD",
        color="#4A90C2"
    ];

    /*
     * Host Global Efficiency decomposition
     */

    host_ge -> host_pe;
    host_ge -> host_cs;

    /*
     * Host Parallel Efficiency decomposition
     */

    host_pe -> mpi_pe;
    host_pe -> offload;

    /*
     * Host Computation Scalability decomposition
     */

    host_cs -> host_ipc;
    host_cs -> host_instruction;
    host_cs -> host_frequency;

    /*
     * Layout constraints
     */

    { rank=same; host_pe; host_cs; }
    { rank=same; mpi_pe; offload; }
    { rank=same; host_ipc; host_instruction; host_frequency; }
}

