<?xml version="1.0" encoding="UTF-8"?>
<!-- Keeps only the I/O call and size events of POSIX/ANSI C (40000004,
     40000011) and MPI-IO (50000005, 50000110), and the descriptor and file
     name of the POSIX/ANSI C calls (40000010, 40000059). The request-size
     distribution (rawdata.parse_io_requests_trace) and the files accessed
     (rawdata.parse_io_files_trace) are computed from the filtered trace;
     the io-*-size-pow2-*.cfg histograms show the same intervals in Paraver
     for POSIX and ANSI C. -->
<config>
  <filter>
    <discard_states>1</discard_states>
    <discard_events>0</discard_events>
    <discard_communications>1</discard_communications>
    <types>
      <type>40000004</type>
      <type>40000011</type>
      <type>50000005</type>
      <type>50000110</type>
      <type>40000010</type>
      <type>40000059</type>
    </types>
  </filter>
</config>
